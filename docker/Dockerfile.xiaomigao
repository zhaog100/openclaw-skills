FROM debian:bookworm

LABEL maintainer="zhaog"
LABEL description="Xiaomigao - OpenClaw QQ Bot Instance"

# 安装 Node.js 22
RUN apt-get update && \
    apt-get install -y curl git procps && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# 验证 Node.js 版本
RUN node --version && npm --version

# 配置 npm 镜像
RUN npm config set registry https://registry.npmmirror.com

# 安装 OpenClaw
RUN npm install -g openclaw@2026.4.5

# 验证 OpenClaw
RUN openclaw --version

# 创建配置目录
RUN mkdir -p /root/.openclaw

# 配置 Gateway
RUN echo '{"gateway":{"port":18790,"host":"0.0.0.0"}}' > /root/.openclaw/config.json

EXPOSE 18790

WORKDIR /root/.openclaw

# 启动脚本
RUN echo '#!/bin/bash\nopenclaw gateway start\ntail -f /dev/null' > /start.sh && \
    chmod +x /start.sh

CMD ["/start.sh"]
