    {
      "name": "智慧厕所-环境传感器",
      "method": "GET",
      "path": "/api/Device/WashRoom/Environment/LatestData",
      "params": {"deviceNo": ""},
      "headers": {"X-H3C-TOKEN": "{{TOKEN}}"},
      "expected_status": 200,
      "assertions": [
        {"type": "status_code", "value": 200},
        {"type": "json_path", "path": "$.code", "value": 200},
        {"type": "json_path", "path": "$.data", "operator": "exists"}
      ],
      "sample_response": {
        "msg": "请求成功",
        "code": 200,
        "data": [{
          "createTime": "2024-01-11 10:35:23",
          "dtuNo": "DT0012AP00001",
          "deviceNo": "ES0012AA00001",
          "beatSpan": 60,
          "powerMode": 2,
          "voltage": 220,
          "nh3": 0.02,
          "h2s": 0.0049,
          "tem": 24,
          "hum": 26,
          "pm25": 9
        }]
      }
    },
