          }
        },
        {
          "name": "Create pet",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Fluffy\"}"
            },
            "url": {
              "protocol": "https",
              "host": ["petstore", "swagger.io"],
              "path": ["v2", "pets"]
            }
          }
        }
      ]
    }
  ]
}
