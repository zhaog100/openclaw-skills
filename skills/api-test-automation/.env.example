# API Test Automation Environment Configuration Template
# Copy to .env.test and fill in your values

# Target API base URL
BASE_URL=https://api.example.com

# Authentication
AUTH_TYPE=jwt
JWT_TOKEN=your-jwt-token-here
BASIC_USERNAME=
BASIC_PASSWORD=

# Test settings
TIMEOUT_SECONDS=30
RETRY_COUNT=3

# Report output
REPORT_DIR=reports
