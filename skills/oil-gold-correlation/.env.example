# .env.example - 环境变量配置模板
# 复制为 .env 并填入实际 API Key

# ================================
# 宏观经济数据源 (FRED)
# ================================
# FRED API Key - 用于获取消费者信心、VIX、收益率曲线利差等宏观数据
# 申请地址: https://fred.stlouisfed.org/docs/api/api_key.html
# 免费: 每日 10,000 次调用
FRED_API_KEY=your_fred_api_key_here

# ================================
# 金融市场数据源
# ================================
# Alpha Vantage - 股票/外汇/大宗商品历史数据
# 申请地址: https://www.alphavantage.co/support/#api-key
# 免费: 每日 500 次调用
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Twelve Data - 实时/历史金融数据
# 申请地址: https://twelvedata.com/
# 免费: 每日 800 次调用
TWELVE_DATA_API_KEY=your_twelve_data_key_here

# ================================
# 配置说明
# ================================
# 1. 数据源自动降级机制:
#    - 优先使用已配置的 API Key
#    - 未配置时自动尝试其他可用源
#    - 所有源均不可用时，报告标注"[数据不可用]"

# 2. 缓存设置:
#    - 缓存目录: cache/
#    - 缓存有效期: 5-30 分钟 (数据源决定)
#    - 手动清理: rm -rf cache/

# 3. 隐私安全:
#    - .env 文件已加入 .gitignore，不会提交到版本控制
#    - 不要将 .env 分享给他人或公开仓库

# ================================
# 快速开始
# ================================
# 1. 复制模板:
#    cp .env.example .env
#
# 2. 编辑 .env 填入你的 API Key
#
# 3. 生成报告:
#    python scripts/unified_report.py --type text
#    python scripts/unified_report.py --type visual
#    python scripts/unified_report.py --type all
#
# 4. 测试报告:
#    python tests/test_report.py