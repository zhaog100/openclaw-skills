  "priority": "forceRule > complexityScore > defaultModel",
  "file_type_mapping": {
    "vision": [".jpg", ".jpeg", ".png", ".gif", ".webp", ".bmp", ".tiff", ".mp4", ".avi", ".mov", ".mkv", ".webm"],
    "coding": [".js", ".jsx", ".ts", ".tsx", ".py", ".java", ".cpp", ".c", ".html", ".css", ".json", ".xml", ".yaml", ".yml", ".go", ".rs", ".rb", ".php"],
    "complex": [".pdf", ".doc", ".docx", ".ppt", ".pptx", ".xls", ".xlsx"],
