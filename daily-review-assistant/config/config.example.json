{
  "version": "2.0",
  "skill_name": "daily-review-assistant",
  "description": "定时回顾今日工作，查漏补缺，更新记忆和知识库",
  "author": "YOUR_NAME (YOUR_GITHUB_USERNAME)",
  "license": "MIT",
  
  "workspace": "${OPENCLAW_WORKSPACE:-~/.openclaw/workspace}",
  "memory_dir": "${OPENCLAW_WORKSPACE:-~/.openclaw/workspace}/memory",
  "knowledge_dir": "${OPENCLAW_WORKSPACE:-~/.openclaw/workspace}/knowledge",
  
  "files": {
    "memory": "${OPENCLAW_WORKSPACE:-~/.openclaw/workspace}/MEMORY.md",
    "heartbeat": "${OPENCLAW_WORKSPACE:-~/.openclaw/workspace}/HEARTBEAT.md",
    "knowledge_index": "${OPENCLAW_WORKSPACE:-~/.openclaw/workspace}/knowledge/INDEX.md"
  },
  
  "git": {
    "branch": "main",
    "remote": "origin"
  },
  
  "thresholds": {
    "memory_stale_hours": 24,
    "heartbeat_stale_hours": 12,
    "pr_stale_days": 7
  },
  
  "features": {
    "task_review": true,
    "git_review": true,
    "issue_review": true,
    "learning_review": true,
    "pr_monitoring": true,
    "financial_tracking": true
  },
  
  "notifications": {
    "qqbot_enabled": true,
    "qqbot_id": "YOUR_QQBOT_CHANNEL_ID",
    "notify_on_completion": true,
    "notify_on_gaps": true
  },
  
  "cron": {
    "morning": "0 12 * * *",
    "evening": "50 23 * * *",
    "timezone": "Asia/Shanghai"
  },
  
  "review": {
    "auto_extract_lessons": true,
    "update_memory_daily": true,
    "generate_execution_summary": true,
    "check_content_quality": true
  },
  
  "logs": {
    "dir": "${OPENCLAW_WORKSPACE:-~/.openclaw/workspace}/skills/daily-review-assistant/logs",
    "level": "info",
    "retention_days": 30
  }
}
